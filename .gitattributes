# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Go source files
*.go text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf

# Configuration files
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
go.mod text eol=lf
go.sum text eol=lf
Makefile text eol=lf

# Documentation
*.md text eol=lf
LICENSE text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.exe binary
